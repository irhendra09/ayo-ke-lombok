# URL backend FastAPI (dipakai server Next.js untuk proxy /api/v1/*)
BACKEND_URL=http://localhost:8000

# tenant_id travel agent yang dokumennya dipakai widget chat
NEXT_PUBLIC_TENANT_ID=lombok-demo

# Domain produksi (dipakai canonical, sitemap, dan gambar sosial)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Nomor WhatsApp tujuan pemesanan manual (format internasional, tanpa +)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# PIN keamanan untuk mengakses halaman unggah dokumen admin (/admin/documents)
NEXT_PUBLIC_ADMIN_PIN=lombok2026
